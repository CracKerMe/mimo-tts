# MiMo TTS 服务环境变量模板
# 复制为 .env 后填入真实值（.env 已被 gitignore，不会入库）

# 必填：小米 MiMo API Key
MIMO_API_KEY=your-mimo-api-key
MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1

# TTS 服务默认值
MIMO_TTS_DEFAULT_VOICE=mia
MIMO_TTS_DEFAULT_FORMAT=wav
MIMO_TTS_DEFAULT_IS_STREAM=false
MIMO_TTS_OPTIMIZE_TEXT_PREVIEW=false
# MIMO_TTS_DEFAULT_STYLE_INSTRUCTION=语速自然，情绪温和

# --- 安全与健壮性（公网部署强烈建议全部开启）---
# 鉴权：true 时要求请求头 X-API-Key 与下方密钥一致
MIMO_TTS_REQUIRE_AUTH=true
MIMO_TTS_SERVER_API_KEY=please-use-a-strong-random-value
# 限流（基于 IP 的内存令牌桶，单实例）
MIMO_TTS_RATE_LIMIT=20
MIMO_TTS_RATE_LIMIT_WINDOW=60
# 输入大小限制（字节）
MIMO_TTS_MAX_TEXT_LENGTH=10000
MIMO_TTS_MAX_FILE_BYTES=10485760
# 上游超时（毫秒）与重试次数
MIMO_API_TIMEOUT=60000
MIMO_API_MAX_RETRIES=2
# 是否把每次合成结果落盘到 tmp/（默认关闭，避免磁盘无限增长）
MIMO_TTS_SAVE_AUDIO=false

PORT=3000
